    IngredientCatalogue "1" --> "0..*" IngredientAllergene
    Allergene "1" --> "0..*" IngredientAllergene
    Utilisateur "1" --> "0..*" UtilisateurAllergene
    Allergene "1" --> "0..*" UtilisateurAllergene
    Recette "1" --> "0..*" Avis
    Utilisateur "1" --> "0..*" Avis
    Recette "1" --> "0..*" Commentaire
    Utilisateur "1" --> "0..*" Commentaire
